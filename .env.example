# Copy to .env.local — never commit .env.local.
# `pnpm run bootstrap` generates and funds the keypairs and writes the file for
# you; `pnpm run deploy:registry` (T6) fills in the contract id.

STELLAR_NETWORK="testnet"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_FRIENDBOT_URL="https://friendbot.stellar.org"

# Registry admin — register_issuer / deactivate_issuer.
ADMIN_PUBLIC_KEY=""
ADMIN_SECRET_KEY=""

# Signs credentials and anchors their hashes.
ISSUER_PUBLIC_KEY=""
ISSUER_SECRET_KEY=""

# Subject of the demo credential (classic path) and the account that pays
# for every wallet session too (`paymentSecret` — F4/T40, `C-20`: who pays
# stays shared until F6 gives each tenant its own funded policy_rail).
AGENT_PUBLIC_KEY=""
AGENT_SECRET_KEY=""

# Required by `apps/web` (F4/T40) — the master seed `@agentpey/tenancy`
# derives each tenant's own signing identity from (SEP-0005/BIP-44). A 24-word
# BIP-39 phrase, generated once via `generateMasterMnemonic()` and never
# regenerated — every tenant's derived agent identity is a function of
# (this phrase, its own key index), so regenerating it changes every tenant's
# identity at once. Not a Stellar secret key: `apps/web` never funds it,
# never signs a transaction with it directly, and it needs no XLM or USDC —
# the identities it derives sign purchase intents off-chain (a JWS, no
# network call); only payment needs a funded account, and payment stays on
# `AGENT_SECRET_KEY` above until F6. Belongs in a dedicated secrets manager
# before this touches real funds (`D1`); `.env.local`/the host's own env vars
# are this pilot's testnet-only equivalent, same tier as every other secret
# on this page.
MASTER_MNEMONIC=""

# Written by deploy:registry.
AGENT_REGISTRY_CONTRACT_ID=""

# Written by deploy:policy-rail (T31) — the shared, classic-path
# `policy_rail` smart account that can pay an x402 invoice with its
# perTx/perDay enforced on chain. Optional: without it, payments come from
# the agent's own classic account (T24). Used only by the no-wallet demo
# path since F6/T58 — a wallet-connected tenant gets its own rail instead.
POLICY_RAIL_CONTRACT_ID=""

# The wasm hash of `contracts/policy-rail`'s current source, already
# uploaded to testnet (`stellar contract upload`). Required for a
# wallet-connected tenant's first payment (F6/T58): `ensureTenantPolicyRail`
# instantiates a new rail per tenant from this same wasm, without
# re-uploading it. Not a secret — public, and safe to commit like
# POLICY_RAIL_CONTRACT_ID above.
POLICY_RAIL_WASM_HASH=""

# Optional — only read by `pnpm demo --adapter=bazaar` (T15). Defaults to the
# live deployment this was verified against if left unset.
BAZAAR_BASE_URL="https://stellar-bazaar-x402.vercel.app"

# Optional — only read by `apps/web` (T51) to build a `consent_url` in
# `POST /v1/consent_sessions`. Without it, the request's own Host header
# (and X-Forwarded-Proto behind a reverse proxy) is used instead — right for
# local dev, but set this explicitly once on a real deployment.
PUBLIC_BASE_URL="https://agentpey.com"

# Required by `apps/web` (T33) — a Postgres connection string for the
# MandateVault. A free Supabase/Neon project's connection string works; the
# vault creates its own `vault_records` table on first use. Replaces the old
# per-session JSONL file, which was lost on every Render redeploy.
#
# Supabase specifically: use the "Session pooler" connection string, not
# "Direct connection". The direct one only resolves to an IPv6 address, and
# Render (like most PaaS hosts) has no IPv6 egress — ENETUNREACH, found in
# production, not in docs. The pooler host (*.pooler.supabase.com) resolves
# to IPv4. After resetting the database password, the pooler can take up to
# a minute to pick it up — a fresh reset failing once with "password
# authentication failed" against the pooler, while the same password works
# against the direct host, means "wait and retry", not "wrong password".
DATABASE_URL=""

# Optional — the PEM contents of the CA certificate for DATABASE_URL's
# Postgres provider (for example, download the CA certificate from Supabase
# or your provider's connection settings). When set, both Postgres clients
# verify the server certificate and refuse a connection whose CA does not
# match. Leave empty only for the pilot's existing encrypted-but-unverified
# compatibility mode when the provider's CA is unavailable in Node.
POSTGRES_CA_CERT=""

# T77 — the *public* address of the account that sponsors each tenant's first
# policy_rail (the public key of AGENT_SECRET_KEY). The status dashboard reads
# its USDC balance to show how much sponsored testnet credit is left. Public
# on purpose: a dashboard that reads balances must never be in a position to
# move one, so it is configured with the address and never the secret.
RESERVE_ADDRESS=

# T79 — SignalDesk's own keys. SignalDesk is a *merchant*, not part of
# AgentPey: these are never interchangeable with AGENT_SECRET_KEY or any other
# key above, and no AgentPey process reads them. `pnpm run signaldesk:setup`
# mints and funds them once and appends them here; it refuses to replace keys
# that already exist, because the merchant's payout account is also its venue
# identity (`signaldesk:G...` in venues.json) and signed Mandates name it.
#
# SIGNALDESK_SECRET_KEY is the account it is paid at and the key its delivery
# receipts are signed with — one public key is all a stranger needs to verify a
# receipt. SIGNALDESK_FACILITATOR_SECRET submits settlement to the network.
SIGNALDESK_SECRET_KEY=""
SIGNALDESK_FACILITATOR_SECRET=""

# Optional — where SignalDesk is reachable from outside, used for the artefact
# and receipt URLs it publishes. Defaults to the request's Host header.
SIGNALDESK_PUBLIC_URL=""

# T80 — RealOps, the pilot's agent platform. It holds no Stellar key: the only
# credential it will ever carry is an AgentPey /v1 API key (T81), which buys it
# exactly one power — asking.
#
# Without RESEND_API_KEY the magic link is shown on screen instead of emailed.
# That is a pilot fallback and the page says what it costs: in that mode the
# email address is NOT verified. Set the key (and a verified sending domain) to
# turn verification on.
RESEND_API_KEY=""
REALOPS_MAIL_FROM=""
REALOPS_PUBLIC_URL=""

# The venue, asset and payout account the grants RealOps proposes will name.
# Naming a different venue here would only produce grants AgentPey refuses:
# AgentPey resolves the venue against its own venues.json, never against this.
PILOT_VENUE_ID=""
PILOT_ASSET_ID=""
PILOT_PAY_TO=""

# T81 — RealOps' AgentPey partner key. The only credential it holds, and the
# only thing it can do with it is ask. Mint one with `pnpm run partner:create`,
# then register where AgentPey may send a person back to after they sign:
#   pnpm run partner:return-origins -- --partner ptn_… --origins https://…
# Without that registration a `return_url` is refused — an allowlist that
# starts empty allows nothing, which is the point.
REALOPS_AGENTPEY_API_KEY=""
AGENTPEY_BASE_URL=""
