# Copy to .env.vitrinee.local (never committed, mode 600). `pnpm vitrinee:bootstrap` generates
# and funds the Stellar keypairs and appends them to .env.vitrinee.local without
# touching the lines you wrote (facilitator key, Jumpseller credentials).

# ---- Network (testnet only, by design: see docs/fase-6-agentguard-comercializacion/vitrinee/CONTEXTO.md) --------------
STELLAR_NETWORK="testnet"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# ---- Gateway ---------------------------------------------------------------
PORT=4021
# mock | jumpseller (day 3)
ADAPTER="mock"
# Public origin of the deployed gateway. Optional: derived from the request
# Host header when unset (right for local dev).
PUBLIC_BASE_URL=""

# ---- Merchant --------------------------------------------------------------
MERCHANT_NAME="Bazar Cordillera"
MERCHANT_COUNTRY="CL"
MERCHANT_CURRENCY="CLP"
# Where x402 settles: the merchant's own Stellar account (payTo). The gateway
# reads only the public key. `pnpm vitrinee:bootstrap` generates the pair and keeps the
# secret in MERCHANT_PAYOUT_SECRET, which nothing but bootstrap ever reads —
# it is there so the merchant (you) can move the testnet USDC later (VT-8).
MERCHANT_STELLAR_ACCOUNT=""
MERCHANT_PAYOUT_SECRET=""
# Signs receipts (JWS) and pays the receipt-registry anchor in XLM. A separate
# key from the payout account on purpose (docs/fase-6-agentguard-comercializacion/vitrinee/DECISIONES.md, VT-8). Holds no USDC.
MERCHANT_SIGNING_ACCOUNT=""
MERCHANT_SIGNING_SECRET=""
# Demo-fixed exchange rate: CLP per 1 USD (docs/fase-6-agentguard-comercializacion/vitrinee/DECISIONES.md, VT-2).
FX_RATE_CLP_USD="950"
REFUND_WINDOW_SECONDS="864000"
# Comma-separated ISO 3166-1 alpha-2 codes.
SHIPPING_COUNTRIES="CL"

# ---- x402 settlement (day 1) -----------------------------------------------
FACILITATOR_URL="https://channels.openzeppelin.com/x402/testnet"
# Generate at https://channels.openzeppelin.com/testnet/gen — cannot be
# retrieved after creation.
FACILITATOR_API_KEY=""

# ---- Receipt registry ------------------------------------------------------
# Written by `pnpm vitrinee:deploy-registry`. Public, also committed in
# deployments/vitrinee-testnet.json; the gateway falls back to that file when unset.
RECEIPT_REGISTRY_ID=""
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Where the gateway keeps its order records (default .vitrinee/orders.json).
ORDERS_FILE=""

# ---- Multi-merchant platform (T103) ----------------------------------------
# Leave both empty to run the single store above, as before. With both set,
# Vitrinee keeps comercios and orders in Postgres and serves one store per
# subdomain of PLATFORM_HOST. In production they come from
# `pnpm run vitrinee:platform-setup`. Locally, point DATABASE_URL at a local
# Postgres, never at the pilot's: this file's merchant is seeded into it.
DATABASE_URL=""
# 32 random bytes, base64. Seals every comercio's secrets (VT-27).
MASTER_KEY=""
# Locally, `localhost` works: browsers and curl resolve <slug>.localhost.
PLATFORM_HOST=""
# The comercio the platform host still serves as a store (transition, T104).
ROOT_COMERCIO=""
# Slug the merchant above is registered under (default bazar-cordillera).
SEED_COMERCIO_SLUG=""

# ---- Jumpseller (day 3) ----------------------------------------------------
JUMPSELLER_LOGIN=""
JUMPSELLER_AUTHTOKEN=""

# ---- Demo agent ------------------------------------------------------------
# The buyer. Needs XLM (friendbot, via bootstrap) and testnet USDC (Circle's
# faucet, by hand: https://faucet.circle.com).
AGENT_ACCOUNT=""
AGENT_SECRET_KEY=""
