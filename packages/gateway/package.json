    "express": "^5.2.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
