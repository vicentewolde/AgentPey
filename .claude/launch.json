{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agentpey-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 8787
    },
    {
      "name": "realops",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@agentpey/realops",
        "run",
        "dev"
      ],
      "port": 4040
    },
    {
      "name": "agentpey-mcp-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.local; set +a; MCP_PUBLIC_URL=http://localhost:3401 PORT=3401 exec pnpm --filter @agentpey/mcp start"
      ],
      "port": 3401
    }
  ]
}
